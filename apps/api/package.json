{
  "name": "@orion/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -- tsx watch ./src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "auth:generate": "better-auth generate --config ./src/lib/auth.ts --output ../../packages/database/src/schema/better-auth.ts -y",
    "seed": "dotenv -- tsx scripts/seed.ts",
    "bootstrap:prod": "tsx scripts/bootstrap-prod.ts"
  },
  "devDependencies": {
    "@orion/eslint-config": "workspace:*",
    "@orion/typescript-config": "workspace:*",
    "@swc/core": "^1.15.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@orion/db": "workspace:*",
    "@orion/domain": "workspace:^",
    "@orion/fhir": "workspace:*",
    "@orion/logger": "workspace:*",
    "@orion/protocols": "workspace:^",
    "@orion/shared": "workspace:^",
    "better-auth": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  }
}
